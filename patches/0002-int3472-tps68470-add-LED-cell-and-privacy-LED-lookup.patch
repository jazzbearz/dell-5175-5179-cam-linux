--- a/drivers/platform/x86/intel/int3472/tps68470.c
+++ b/drivers/platform/x86/intel/int3472/tps68470.c
@@ -4,7 +4,9 @@
 #include <linux/acpi.h>
 #include <linux/i2c.h>
 #include <linux/kernel.h>
+#include <linux/leds.h>
 #include <linux/mfd/core.h>
+#include <linux/moduleparam.h>
 #include <linux/mfd/tps68470.h>
 #include <linux/platform_device.h>
 #include <linux/platform_data/tps68470.h>
@@ -17,7 +19,57 @@
 #define DESIGNED_FOR_CHROMEOS		1
 #define DESIGNED_FOR_WINDOWS		2
 
-#define TPS68470_WIN_MFD_CELL_COUNT	3
+#define TPS68470_WIN_MFD_CELL_COUNT	4
+
+static char *privacy_led = "";
+module_param(privacy_led, charp, 0444);
+MODULE_PARM_DESC(privacy_led,
+		 "Indicator output used as the camera privacy LED: \"a\", \"b\" or empty (none)");
+
+static struct led_lookup_data *tps68470_led_lookups;
+static unsigned int tps68470_n_led_lookups;
+
+/*
+ * Link the chosen ILED output to every sensor this PMIC serves, so the V4L2
+ * core turns it on while streaming. Must run before the sensors probe.
+ */
+static void skl_int3472_tps68470_add_led_lookups(struct device *dev,
+		const struct int3472_tps68470_board_data *board_data)
+{
+	const char *provider;
+	unsigned int i;
+
+	if (!strcmp(privacy_led, "a"))
+		provider = "tps68470::ileda";
+	else if (!strcmp(privacy_led, "b"))
+		provider = "tps68470::iledb";
+	else
+		return;
+
+	tps68470_led_lookups = devm_kcalloc(dev, board_data->n_gpiod_lookups,
+					    sizeof(*tps68470_led_lookups), GFP_KERNEL);
+	if (!tps68470_led_lookups)
+		return;
+
+	for (i = 0; i < board_data->n_gpiod_lookups; i++) {
+		tps68470_led_lookups[i].provider = provider;
+		tps68470_led_lookups[i].dev_id = board_data->tps68470_gpio_lookup_tables[i]->dev_id;
+		/* v4l2_subdev_get_privacy_led() looks up con_id "privacy" */
+		tps68470_led_lookups[i].con_id = "privacy";
+		led_add_lookup(&tps68470_led_lookups[i]);
+	}
+	tps68470_n_led_lookups = board_data->n_gpiod_lookups;
+	dev_info(dev, "privacy LED: %s\n", provider);
+}
+
+static void skl_int3472_tps68470_remove_led_lookups(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < tps68470_n_led_lookups; i++)
+		led_remove_lookup(&tps68470_led_lookups[i]);
+	tps68470_n_led_lookups = 0;
+}
 
