--- a/drivers/mfd/intel-lpss-acpi.c
+++ b/drivers/mfd/intel-lpss-acpi.c
@@ -8,7 +8,9 @@
  *          Mika Westerberg <mika.westerberg@linux.intel.com>
  */
 
+#include <linux/acpi.h>
 #include <linux/device.h>
+#include <linux/dmi.h>
 #include <linux/gfp_types.h>
 #include <linux/ioport.h>
 #include <linux/mod_devicetable.h>
@@ -172,6 +174,21 @@
 };
 MODULE_DEVICE_TABLE(acpi, intel_lpss_acpi_ids);
 
+/*
+ * Some Dell 2-in-1s declare a GEXP OpRegion that overlaps the I2C4 (INT3446)
+ * MMIO range, so the controller fails with -EBUSY and the front camera
+ * sensor behind it never appears.
+ */
+static const struct dmi_system_id intel_lpss_acpi_conflict_quirks[] = {
+	{
+		.matches = {
+			DMI_EXACT_MATCH(DMI_SYS_VENDOR, "Dell Inc."),
+			DMI_EXACT_MATCH(DMI_PRODUCT_NAME, "Latitude 5179"),
+		},
+	},
+	{ }
+};
+
 static int intel_lpss_acpi_probe(struct platform_device *pdev)
 {
 	const struct intel_lpss_platform_info *data;
@@ -190,6 +207,10 @@
 	info->mem = platform_get_resource(pdev, IORESOURCE_MEM, 0);
 	info->irq = platform_get_irq(pdev, 0);
 
+	if (dmi_check_system(intel_lpss_acpi_conflict_quirks) &&
+	    acpi_dev_hid_match(ACPI_COMPANION(&pdev->dev), "INT3446"))
+		info->quirks |= QUIRK_IGNORE_RESOURCE_CONFLICTS;
+
 	ret = intel_lpss_probe(&pdev->dev, info);
 	if (ret)
 		return ret;
