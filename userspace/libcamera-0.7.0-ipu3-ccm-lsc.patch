+++ b/src/ipa/ipu3/algorithms/lsc.h	2026-11-19 16:49:18.068457318 +0900
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * IPU3 Lens Shading Correction from tuning data
+ */
+
+#pragma once
+
+#include <array>
+#include <map>
+#include <memory>
+#include <vector>
+
+#include <libcamera/geometry.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::ipu3::algorithms {
+
+class Lsc : public Algorithm
+{
+public:
+	Lsc() = default;
+
+	int init(IPAContext &context, const YamlObject &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     ipu3_uapi_params *params) override;
+
+private:
+	using Tables = std::array<std::vector<float>, 4>;
+
+	void computeLut(unsigned int ct);
+	float sample(const std::vector<float> &table, float u, float v) const;
+
+	/* Tuning data */
+	Size tuningSize_;
+	unsigned int tuningW_ = 0;
+	unsigned int tuningH_ = 0;
+	std::array<unsigned int, 4> channelMap_ = { 0, 1, 2, 3 };
+	std::map<unsigned int, Tables> sets_;
+	int testValue_ = -1;
+	int gainFactorOverride_ = -1;
+	int testChannel_ = -1;
+
+	/* Session geometry */
+	Size activeArea_;
+	Rectangle analogCrop_;
+	Size outputSize_;
+	Size ifSize_;
+	Size bdsSize_;
+	ipu3_uapi_shd_grid_config grid_ = {};
+	unsigned int gainFactor_ = 0;
+	bool configured_ = false;
+
+	std::unique_ptr<ipu3_uapi_shd_lut> lut_;
+	unsigned int lastCt_ = 0;
+};
+
+} /* namespace ipa::ipu3::algorithms */
+
+} /* namespace libcamera */
