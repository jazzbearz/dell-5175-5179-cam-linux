+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * IPU3 Colour Correction Matrix from tuning data
+ */
+
+#include "ccm.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+/**
+ * \file ccm.h
+ */
+
+namespace libcamera {
+
+namespace ipa::ipu3::algorithms {
+
+/**
+ * \class Ccm
+ * \brief Program the ImgU colour correction matrix from per-colour-temperature
+ * tuning data, interpolated with the AWB colour temperature estimate
+ *
+ * The ImgU CCM uses s2.13 coefficients (8192 = 1.0) with a per-channel bias.
+ * This algorithm must be listed after Awb in the tuning file, as Awb writes a
+ * fixed default matrix.
+ */
+
+LOG_DEFINE_CATEGORY(IPU3Ccm)
+
+int Ccm::init([[maybe_unused]] IPAContext &context, const YamlObject &tuningData)
+{
+	int ret = ccm_.readYaml(tuningData["ccms"], "ct", "ccm");
+	if (ret < 0) {
+		LOG(IPU3Ccm, Error) << "Failed to parse 'ccms' from tuning data";
+		return ret;
+	}
+
+	/*
+	 * Optional strength: 1.0 applies the tuned matrices as-is, 0.0 is the
+	 * identity. Blending keeps each row summing to 1 (white preserved).
+	 */
+	saturation_ = tuningData["saturation"].get<double>(1.0);
+
+	LOG(IPU3Ccm, Info) << "Loaded " << ccm_.data().size() << " CCMs, saturation "
+			   << saturation_;
+	return 0;
+}
+
+static int16_t ccmCoeff(float v)
+{
+	long c = std::lround(v * 8192.0f);
+	return static_cast<int16_t>(std::clamp<long>(c, -32768, 32767));
+}
+
+void Ccm::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  ipu3_uapi_params *params)
+{
+	unsigned int ct = static_cast<unsigned int>(context.activeState.awb.temperatureK);
+	/* Quantize to limit recomputation. */
+	ct = (ct + 50) / 100 * 100;
+
+	const Matrix<float, 3, 3> &tuned = ccm_.getInterpolated(ct);
+	Matrix<float, 3, 3> m = Matrix<float, 3, 3>::identity() * (1.0 - saturation_) +
+				tuned * saturation_;
+	ipu3_uapi_ccm_mat_config &c = params->acc_param.ccm;
+
+	c.coeff_m11 = ccmCoeff(m[0][0]);
+	c.coeff_m12 = ccmCoeff(m[0][1]);
+	c.coeff_m13 = ccmCoeff(m[0][2]);
+	c.coeff_o_r = 0;
+	c.coeff_m21 = ccmCoeff(m[1][0]);
+	c.coeff_m22 = ccmCoeff(m[1][1]);
+	c.coeff_m23 = ccmCoeff(m[1][2]);
+	c.coeff_o_g = 0;
+	c.coeff_m31 = ccmCoeff(m[2][0]);
+	c.coeff_m32 = ccmCoeff(m[2][1]);
+	c.coeff_m33 = ccmCoeff(m[2][2]);
+	c.coeff_o_b = 0;
+
+	params->use.acc_ccm = 1;
+
+	if (ct != lastCt_) {
+		LOG(IPU3Ccm, Debug) << "CT " << ct << " CCM " << m;
+		lastCt_ = ct;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Ccm, "Ccm")
+
+} /* namespace ipa::ipu3::algorithms */
+
+} /* namespace libcamera */
