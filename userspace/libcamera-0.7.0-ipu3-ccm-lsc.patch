 /**
+ * \brief Load the optional sensor white locus from tuning data
+ *
+ * The locus lists, for reference illuminants, the colour temperature and the
+ * raw sensor R/G and B/G ratios of a white surface (Intel CMC record 15).
+ * When present, the grey-world estimate is projected onto it: the colour
+ * temperature is read from the locus and, if constrainToLocus is set, the
+ * gains are taken from the projected point, which removes green/magenta
+ * casts.
+ */
+int Awb::init([[maybe_unused]] IPAContext &context, const YamlObject &tuningData)
+{
+	locus_.clear();
+	for (const auto &p : tuningData["locus"].asList()) {
+		auto ct = p["ct"].get<double>();
+		auto rg = p["rg"].get<double>();
+		auto bg = p["bg"].get<double>();
+		if (!ct || !rg || !bg)
+			return -EINVAL;
+		locus_.push_back({ *ct, *rg, *bg });
+	}
+	std::sort(locus_.begin(), locus_.end(),
+		  [](const LocusPoint &a, const LocusPoint &b) { return a.ct < b.ct; });
+	constrainToLocus_ = tuningData["constrainToLocus"].get<bool>(true);
+
+	if (!locus_.empty())
+		LOG(IPU3Awb, Info) << "Using sensor white locus with "
+				   << locus_.size() << " points";
+	return 0;
+}
+
+void Awb::applyLocus(double &redGain, double &blueGain)
+{
+	if (locus_.size() < 2)
+		return;
+
+	double rg = 1.0 / std::max(redGain, 1e-3);
+	double bg = 1.0 / std::max(blueGain, 1e-3);
+
+	double bestDist = std::numeric_limits<double>::max();
+	double bestCt = locus_.front().ct, bestRg = rg, bestBg = bg;
+	for (size_t i = 0; i + 1 < locus_.size(); i++) {
+		const LocusPoint &a = locus_[i], &b = locus_[i + 1];
+		double dx = b.rg - a.rg, dy = b.bg - a.bg;
+		double len2 = dx * dx + dy * dy;
+		double t = len2 > 0 ? ((rg - a.rg) * dx + (bg - a.bg) * dy) / len2 : 0;
+		t = std::clamp(t, 0.0, 1.0);
+		double px = a.rg + t * dx, py = a.bg + t * dy;
+		double d = (rg - px) * (rg - px) + (bg - py) * (bg - py);
+		if (d < bestDist) {
+			bestDist = d;
+			bestCt = a.ct + t * (b.ct - a.ct);
+			bestRg = px;
+			bestBg = py;
+		}
+	}
+
+	LOG(IPU3Awb, Debug) << "Locus: measured R/G " << rg << " B/G " << bg
+			    << " -> " << bestRg << "/" << bestBg << " CT " << bestCt;
+
+	asyncResults_.temperatureK = bestCt;
+	if (constrainToLocus_) {
+		redGain = 1.0 / bestRg;
+		blueGain = 1.0 / bestBg;
+	}
+}
