+} /* namespace libcamera */
diff -ruN a/src/ipa/ipu3/algorithms/lsc.cpp b/src/ipa/ipu3/algorithms/lsc.cpp
--- a/src/ipa/ipu3/algorithms/lsc.cpp	1970-01-01 09:00:00.000000000 +0900
+++ b/src/ipa/ipu3/algorithms/lsc.cpp	2026-11-19 16:49:18.068564501 +0900
@@ -0,0 +1,291 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * IPU3 Lens Shading Correction from tuning data
+ */
+
+#include "lsc.h"
+
+#include <algorithm>
+#include <cmath>
+#include <string.h>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+/**
+ * \file lsc.h
+ */
+
+namespace libcamera {
+
+namespace ipa::ipu3::algorithms {
+
+/**
+ * \class Lsc
+ * \brief Bayer lens-shading correction using per-colour-temperature gain grids
+ *
+ * Tuning data holds gain grids (4096 = 1.0) covering the full sensor
+ * (\a sensorSize) for four Bayer channels, per colour temperature. For each
+ * session the grids are mapped through the sensor analogue crop and scaling
+ * onto the raw frame, resampled to an ImgU shading grid and encoded as
+ * (gain - 1) * 1024 >> gain_factor (u12).
+ *
+ * Optional tuning keys for bring-up:
+ *  - testPattern: fixed LUT value on the left half of the frame, 0 elsewhere
+ *  - gainFactor: force the ImgU gain_factor (0, 1 or 2)
+ *  - channelMap: tuning channel index used for ImgU r, gr, gb, b
+ */
+
+LOG_DEFINE_CATEGORY(IPU3Lsc)
+
+static constexpr unsigned int kMaxCellsPerSet = IPU3_UAPI_SHD_MAX_CELLS_PER_SET;
+static constexpr unsigned int kMaxSets = IPU3_UAPI_SHD_MAX_CFG_SETS;
+
+int Lsc::init([[maybe_unused]] IPAContext &context, const YamlObject &tuningData)
+{
+	auto size = tuningData["sensorSize"].getList<unsigned int>();
+	auto grid = tuningData["grid"].getList<unsigned int>();
+	if (!size || size->size() != 2 || !grid || grid->size() != 2) {
+		LOG(IPU3Lsc, Error) << "Missing sensorSize or grid";
+		return -EINVAL;
+	}
+	tuningSize_ = { (*size)[0], (*size)[1] };
+	tuningW_ = (*grid)[0];
+	tuningH_ = (*grid)[1];
+
+	auto map = tuningData["channelMap"].getList<unsigned int>();
+	if (map && map->size() == 4)
+		std::copy(map->begin(), map->end(), channelMap_.begin());
+
+	testValue_ = tuningData["testPattern"].get<int>(-1);
+	gainFactorOverride_ = tuningData["gainFactor"].get<int>(-1);
+	testChannel_ = tuningData["testChannel"].get<int>(-1);
+
+	const unsigned int cells = tuningW_ * tuningH_;
+	for (const auto &set : tuningData["sets"].asList()) {
+		unsigned int ct = set["ct"].get<unsigned int>(0);
+		Tables tables;
+		for (unsigned int c = 0; c < 4; c++) {
+			auto values = set["c" + std::to_string(c)].getList<uint16_t>();
+			if (!values || values->size() != cells) {
+				LOG(IPU3Lsc, Error) << "Bad table c" << c << " for ct " << ct;
+				return -EINVAL;
+			}
+			tables[c].resize(cells);
+			for (unsigned int i = 0; i < cells; i++)
+				tables[c][i] = (*values)[i] / 4096.0f;
+		}
+		sets_[ct] = std::move(tables);
+	}
+
+	if (sets_.empty() && testValue_ < 0) {
+		LOG(IPU3Lsc, Error) << "No LSC sets";
+		return -EINVAL;
+	}
+
+	lut_ = std::make_unique<ipu3_uapi_shd_lut>();
+
+	LOG(IPU3Lsc, Info) << "Loaded " << sets_.size() << " LSC sets "
+			   << tuningW_ << "x" << tuningH_;
+	return 0;
+}
+
+int Lsc::configure([[maybe_unused]] IPAContext &context,
+		   const IPAConfigInfo &configInfo)
+{
+	const IPACameraSensorInfo &info = configInfo.sensorInfo;
+	activeArea_ = info.activeAreaSize;
+	analogCrop_ = info.analogCrop;
+	outputSize_ = info.outputSize;
+	/*
+	 * The shading block runs after the Bayer down-scaler: the grid is in
+	 * BDS output coordinates. The BDS input is the IF crop, which libcamera
+	 * places at the top-left corner of the raw frame.
+	 */
+	ifSize_ = configInfo.iif;
+	bdsSize_ = configInfo.bdsOutputSize;
+	if (ifSize_.isNull() || bdsSize_.isNull()) {
+		LOG(IPU3Lsc, Error) << "Missing IF/BDS sizes";
+		return -EINVAL;
+	}
+
+	/* Pick the finest grid that fits the ImgU shading LUT limits. */
+	unsigned int bw = 3, w = 0;
+	for (; bw <= 7; bw++) {
+		w = (bdsSize_.width + (1u << bw) - 1) / (1u << bw) + 1;
+		if (w <= 73)
+			break;
+	}
+	unsigned int perSlice = kMaxCellsPerSet / w;
+	unsigned int bh = 3, h = 0;
+	for (; bh <= 7; bh++) {
+		h = (bdsSize_.height + (1u << bh) - 1) / (1u << bh) + 1;
+		if (h <= kMaxSets * perSlice && h <= 128)
+			break;
+	}
+	if (bw > 7 || bh > 7) {
+		LOG(IPU3Lsc, Error) << "Cannot fit shading grid for " << bdsSize_;
+		return -EINVAL;
+	}
+
+	grid_ = {};
+	grid_.width = w;
+	grid_.height = h;
+	grid_.block_width_log2 = bw;
+	grid_.block_height_log2 = bh;
+	grid_.grid_height_per_slice = perSlice;
+	grid_.x_start = 0;
+	grid_.y_start = 0;
+
+	lastCt_ = 0;
+	configured_ = true;
+
+	LOG(IPU3Lsc, Info) << "Output " << outputSize_ << " crop " << analogCrop_
+			   << " active " << activeArea_ << " IF " << ifSize_
+			   << " BDS " << bdsSize_ << " -> grid " << w << "x" << h
+			   << " cells " << (1u << bw) << "x" << (1u << bh);
+	return 0;
+}
+
+float Lsc::sample(const std::vector<float> &table, float u, float v) const
+{
+	u = std::clamp(u, 0.0f, static_cast<float>(tuningW_ - 1));
+	v = std::clamp(v, 0.0f, static_cast<float>(tuningH_ - 1));
+	unsigned int x0 = std::min(static_cast<unsigned int>(u), tuningW_ - 2);
+	unsigned int y0 = std::min(static_cast<unsigned int>(v), tuningH_ - 2);
+	float fx = u - x0, fy = v - y0;
+	const float *r0 = &table[y0 * tuningW_];
+	const float *r1 = &table[(y0 + 1) * tuningW_];
+	float top = r0[x0] * (1 - fx) + r0[x0 + 1] * fx;
+	float bot = r1[x0] * (1 - fx) + r1[x0 + 1] * fx;
+	return top * (1 - fy) + bot * fy;
+}
+
+void Lsc::computeLut(unsigned int ct)
+{
+	const unsigned int w = grid_.width, h = grid_.height;
+	const unsigned int perSlice = grid_.grid_height_per_slice;
+
+	/* Gains on the ImgU grid, per ImgU channel (r, gr, gb, b). */
+	std::array<std::vector<float>, 4> gains;
+	for (auto &g : gains)
+		g.assign(w * h, 1.0f);
+
+	float maxGain = 1.0f;
+
+	if (testValue_ < 0) {
+		/* Interpolate between the two nearest colour temperatures. */
+		auto hi = sets_.lower_bound(ct);
+		const Tables *a, *b;
+		float lambda = 0.0f;
+		if (hi == sets_.begin()) {
+			a = b = &hi->second;
+		} else if (hi == sets_.end()) {
+			a = b = &std::prev(hi)->second;
+		} else {
+			auto lo = std::prev(hi);
+			a = &lo->second;
+			b = &hi->second;
+			lambda = static_cast<float>(ct - lo->first) / (hi->first - lo->first);
+		}
+
+		/* Tuning grid is centred on the active area. */
+		float offX = (static_cast<float>(tuningSize_.width) - activeArea_.width) / 2;
+		float offY = (static_cast<float>(tuningSize_.height) - activeArea_.height) / 2;
+		/* BDS pixel -> raw pixel (IF at origin) -> sensor array. */
+		float bx = static_cast<float>(ifSize_.width) / bdsSize_.width;
+		float by = static_cast<float>(ifSize_.height) / bdsSize_.height;
+		float sx = static_cast<float>(analogCrop_.width) / outputSize_.width;
+		float sy = static_cast<float>(analogCrop_.height) / outputSize_.height;
+		float ku = (tuningW_ - 1) / static_cast<float>(tuningSize_.width);
+		float kv = (tuningH_ - 1) / static_cast<float>(tuningSize_.height);
+
+		for (unsigned int i = 0; i < h; i++) {
+			float py = std::min<float>(i << grid_.block_height_log2, bdsSize_.height - 1) * by;
+			float v = (analogCrop_.y + py * sy + offY) * kv;
+			for (unsigned int j = 0; j < w; j++) {
+				float px = std::min<float>(j << grid_.block_width_log2, bdsSize_.width - 1) * bx;
+				float u = (analogCrop_.x + px * sx + offX) * ku;
+				for (unsigned int c = 0; c < 4; c++) {
+					unsigned int src = channelMap_[c];
+					float g = sample(a->at(src), u, v) * (1 - lambda) +
+						  sample(b->at(src), u, v) * lambda;
+					gains[c][i * w + j] = g;
+					maxGain = std::max(maxGain, g);
+				}
+			}
+		}
+	}
+
+	if (gainFactorOverride_ >= 0)
+		gainFactor_ = gainFactorOverride_;
+	else
+		gainFactor_ = maxGain < 4.99f ? 0 : maxGain < 8.99f ? 1 : 2;
+
+	memset(lut_.get(), 0, sizeof(*lut_));
+	/*
+	 * Measured on IPU3: LUT entries are u12 and the applied gain is
+	 * 1 + v * 2^gain_factor / 1024, i.e. [1, 5), [1, 9) or [1, 17).
+	 */
+	const float scale = 1024.0f / (1u << gainFactor_);
+
+	auto encode = [&](unsigned int c, unsigned int i, unsigned int j) -> uint16_t {
+		if (testValue_ >= 0) {
+			if (testChannel_ >= 0)
+				return static_cast<int>(c) == testChannel_ ? testValue_ : 0;
+			return j < w / 2 ? testValue_ : 0;
+		}
+		float v = std::lround((gains[c][i * w + j] - 1.0f) * scale);
+		return static_cast<uint16_t>(std::clamp(v, 0.0f, 4095.0f));
+	};
+
+	for (unsigned int i = 0; i < h; i++) {
+		unsigned int set = i / perSlice;
+		unsigned int row = i % perSlice;
+		if (set >= kMaxSets)
+			break;
+		/* Packed struct: no references to members. */
+		for (unsigned int j = 0; j < w; j++) {
+			unsigned int idx = row * w + j;
+			lut_->sets[set].r_and_gr[idx].r = encode(0, i, j);
+			lut_->sets[set].r_and_gr[idx].gr = encode(1, i, j);
+			lut_->sets[set].gb_and_b[idx].gb = encode(2, i, j);
+			lut_->sets[set].gb_and_b[idx].b = encode(3, i, j);
+		}
+	}
+
+	LOG(IPU3Lsc, Debug) << "CT " << ct << " max gain " << maxGain
+			    << " gain_factor " << gainFactor_;
+}
+
+void Lsc::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  ipu3_uapi_params *params)
+{
+	if (!configured_)
+		return;
+
+	unsigned int ct = static_cast<unsigned int>(context.activeState.awb.temperatureK);
+	ct = (ct + 50) / 100 * 100;
+	if (ct != lastCt_ || ct == 0) {
+		computeLut(ct);
+		lastCt_ = ct;
+	}
+
+	ipu3_uapi_shd_config &shd = params->acc_param.shd;
+	shd.shd.grid = grid_;
+	shd.shd.general = {};
+	shd.shd.general.shd_enable = 1;
+	shd.shd.general.gain_factor = gainFactor_;
+	shd.shd.black_level = {};
+	shd.shd_lut = *lut_;
+
+	params->use.acc_shd = 1;
+}
+
+REGISTER_IPA_ALGORITHM(Lsc, "Lsc")
+
+} /* namespace ipa::ipu3::algorithms */
+
+} /* namespace libcamera */
